{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*", "shared/**/*"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  }
}
